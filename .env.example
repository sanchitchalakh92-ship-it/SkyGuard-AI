# SkyGuard AI Environment Configuration
# Problem Statement: SIH 26073 - MoES / IMD AWS Anomaly Detection

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Data Source Mode: "simulator" | "open_meteo" | "owm" | "hybrid"
DEFAULT_DATA_SOURCE=simulator

# External API Keys (Optional - Open-Meteo works without key)
OPENWEATHERMAP_API_KEY=
WEATHERAPI_KEY=
ANTHROPIC_API_KEY=
DATA_GOV_IN_API_KEY=

# Alert Webhook / Notifications (Optional)
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Storage Paths
DATABASE_URL=sqlite:///./data/skyguard.db
HISTORICAL_DATA_DIR=./data/historical
MODEL_CHECKPOINT_DIR=./data/models
